{
  "name": "dsh-plugin-mobile-pair",
  "description": "Print a scannable pairing QR for the DSH Mobile Android app when the Web GUI starts.",
  "version": "0.7.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coolwolfqs/dsh-mobile-client.git",
    "directory": "packages/dsh-plugin-mobile-pair"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "docs",
    "lib/index.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "android",
    "pairing",
    "qrcode"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  }
}
